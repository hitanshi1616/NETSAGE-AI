# Copy this file to .env and fill in real values.
# .env is (and must stay) git-ignored -- never commit real API keys.

# Required only if you use checker/ai_diagnose.py to call the Anthropic API
# directly. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the default model. Check the current model catalog at
# https://docs.claude.com/en/docs/about-claude/models before changing this,
# since model names/availability change over time.
ANTHROPIC_MODEL=claude-sonnet-4-5
